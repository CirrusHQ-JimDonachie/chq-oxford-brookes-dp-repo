      "feels_like_temperature_c": {"M": {"min": {"S": "-40"}, "max": {"S": "50"}}},
      "humidity_pct": {"M": {"min": {"S": "0"}, "max": {"S": "100"}}},
      "precipitation_mm": {"M": {"min": {"S": "0"}, "max": {"S": "100"}}},
      "wind_speed_kmh": {"M": {"min": {"S": "0"}, "max": {"S": "200"}}},
      "solar_radiation_wm2": {"M": {"min": {"S": "0"}, "max": {"S": "1400"}}},
      "cloud_cover_pct": {"M": {"min": {"S": "0"}, "max": {"S": "100"}}}
    }}
  }},
  "entity": {"M": {"type": {"S": "site"}, "key_field": {"S": "location_id"}}},
  "target_table": {"S": "building_data.weather_hourly"}
}
