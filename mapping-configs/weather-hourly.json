{
  "pk": {"S": "config#weather#hourly"},
  "sk": {"S": "mapping"},
  "input_format": {"S": "csv"},
  "has_header": {"BOOL": true},
  "fields": {"L": [
    {"M": {"from": {"S": "time"}, "to": {"S": "reading_at"}, "type": {"S": "timestamp"}, "format": {"S": "iso8601"}}},
    {"M": {"from": {"S": "location"}, "to": {"S": "location_id"}, "type": {"S": "string"}}},
    {"M": {"from": {"S": "latitude"}, "to": {"S": "latitude"}, "type": {"S": "decimal"}}},
    {"M": {"from": {"S": "longitude"}, "to": {"S": "longitude"}, "type": {"S": "decimal"}}},
    {"M": {"from": {"S": "temperature_2m"}, "to": {"S": "air_temperature_c"}, "type": {"S": "decimal"}}},
    {"M": {"from": {"S": "relative_humidity_2m"}, "to": {"S": "humidity_pct"}, "type": {"S": "decimal"}}},
    {"M": {"from": {"S": "apparent_temperature"}, "to": {"S": "feels_like_temperature_c"}, "type": {"S": "decimal"}}},
    {"M": {"from": {"S": "precipitation"}, "to": {"S": "precipitation_mm"}, "type": {"S": "decimal"}}},
