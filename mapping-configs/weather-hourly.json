    {"M": {"from": {"S": "shortwave_radiation"}, "to": {"S": "solar_radiation_wm2"}, "type": {"S": "decimal"}}},
    {"M": {"from": {"S": "cloud_cover"}, "to": {"S": "cloud_cover_pct"}, "type": {"S": "decimal"}}}
  ]},
  "validation": {"M": {
    "required": {"L": [{"S": "reading_at"}, {"S": "location_id"}, {"S": "air_temperature_c"}, {"S": "humidity_pct"}]},
    "ranges": {"M": {
