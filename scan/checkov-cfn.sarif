{"$schema": "https://raw.githubusercontent.com/oasis-tcs/sarif-spec/main/sarif-2.1/schema/sarif-schema-2.1.0.json", "version": "2.1.0", "runs": [{"tool": {"driver": {"name": "Checkov", "version": "3.2.527", "informationUri": "https://checkov.io", "rules": [{"id": "CKV_AWS_120", "name": "Ensure API Gateway caching is enabled", "shortDescription": {"text": "Ensure API Gateway caching is enabled"}, "fullDescription": {"text": "Ensure API Gateway caching is enabled"}, "help": {"text": "Ensure API Gateway caching is enabled\nResource: AWS::ApiGateway::Stage.ReadApiStage"}, "defaultConfiguration": {"level": "error"}, "helpUri": "https://docs.prismacloud.io/en/enterprise-edition/policy-reference/aws-policies/aws-general-policies/ensure-api-gateway-caching-is-enabled"}, {"id": "CKV_AWS_73", "name": "Ensure API Gateway has X-Ray Tracing enabled", "shortDescription": {"text": "Ensure API Gateway has X-Ray Tracing enabled"}, "fullDescription": {"text": "Ensure API Gateway has X-Ray Tracing enabled"}, "help": {"text": "Ensure API Gateway has X-Ray Tracing enabled\nResource: AWS::ApiGateway::Stage.ReadApiStage"}, "defaultConfiguration": {"level": "error"}, "helpUri": "https://docs.prismacloud.io/en/enterprise-edition/policy-reference/aws-policies/aws-logging-policies/logging-15"}, {"id": "CKV_AWS_21", "name": "Ensure the S3 bucket has versioning enabled", "shortDescription": {"text": "Ensure the S3 bucket has versioning enabled"}, "fullDescription": {"text": "Ensure the S3 bucket has versioning enabled"}, "help": {"text": "Ensure the S3 bucket has versioning enabled\nResource: AWS::S3::Bucket.AthenaResultsBucket"}, "defaultConfiguration": {"level": "error"}, "helpUri": "https://docs.prismacloud.io/en/enterprise-edition/policy-reference/aws-policies/s3-policies/s3-16-enable-versioning"}, {"id": "CKV_AWS_18", "name": "Ensure the S3 bucket has access logging enabled", "shortDescription": {"text": "Ensure the S3 bucket has access logging enabled"}, "fullDescription": {"text": "Ensure the S3 bucket has access logging enabled"}, "help": {"text": "Ensure the S3 bucket has access logging enabled\nResource: AWS::S3::Bucket.AthenaResultsBucket"}, "defaultConfiguration": {"level": "error"}, "helpUri": "https://docs.prismacloud.io/en/enterprise-edition/policy-reference/aws-policies/s3-policies/s3-13-enable-logging"}, {"id": "CKV_AWS_117", "name": "Ensure that AWS Lambda function is configured inside a VPC", "shortDescription": {"text": "Ensure that AWS Lambda function is configured inside a VPC"}, "fullDescription": {"text": "Ensure that AWS Lambda function is configured inside a VPC"}, "help": {"text": "Ensure that AWS Lambda function is configured inside a VPC\nResource: AWS::Serverless::Function.TransformFunction"}, "defaultConfiguration": {"level": "error"}, "helpUri": "https://docs.prismacloud.io/en/enterprise-edition/policy-reference/aws-policies/aws-general-policies/ensure-that-aws-lambda-function-is-configured-inside-a-vpc-1"}, {"id": "CKV_AWS_116", "name": "Ensure that AWS Lambda function is configured for a Dead Letter Queue(DLQ)", "shortDescription": {"text": "Ensure that AWS Lambda function is configured for a Dead Letter Queue(DLQ)"}, "fullDescription": {"text": "Ensure that AWS Lambda function is configured for a Dead Letter Queue(DLQ)"}, "help": {"text": "Ensure that AWS Lambda function is configured for a Dead Letter Queue(DLQ)\nResource: AWS::Serverless::Function.TransformFunction"}, "defaultConfiguration": {"level": "error"}, "helpUri": "https://docs.prismacloud.io/en/enterprise-edition/policy-reference/aws-policies/aws-general-policies/ensure-that-aws-lambda-function-is-configured-for-a-dead-letter-queue-dlq"}, {"id": "CKV_AWS_115", "name": "Ensure that AWS Lambda function is configured for function-level concurrent execution limit", "shortDescription": {"text": "Ensure that AWS Lambda function is configured for function-level concurrent execution limit"}, "fullDescription": {"text": "Ensure that AWS Lambda function is configured for function-level concurrent execution limit"}, "help": {"text": "Ensure that AWS Lambda function is configured for function-level concurrent execution limit\nResource: AWS::Serverless::Function.TransformFunction"}, "defaultConfiguration": {"level": "error"}, "helpUri": "https://docs.prismacloud.io/en/enterprise-edition/policy-reference/aws-policies/aws-general-policies/ensure-that-aws-lambda-function-is-configured-for-function-level-concurrent-execution-limit"}], "organization": "bridgecrew"}}, "results": [{"ruleId": "CKV_AWS_120", "ruleIndex": 0, "level": "error", "attachments": [], "message": {"text": "Ensure API Gateway caching is enabled"}, "locations": [{"physicalLocation": {"artifactLocation": {"uri": "cloudformation/nested/api.yaml"}, "region": {"startLine": 372, "endLine": 383, "snippet": {"text": "  ReadApiStage:\n    Type: AWS::ApiGateway::Stage\n    DependsOn: ApiGatewayAccount\n    Properties:\n      RestApiId: !Ref ReadApi\n      StageName: v1\n      DeploymentId: !Ref ReadApiDeployment9c2ad4\n      Description: The stage the client calls.\n      TracingEnabled: false\n      AccessLogSetting:\n        DestinationArn: !GetAtt ReadApiAccessLogGroup.Arn\n        Format: '{\"requestId\":\"$context.requestId\",\"extendedRequestId\":\"$context.extendedRequestId\",\"ip\":\"$context.identity.sourceIp\",\"requestTime\":\"$context.requestTime\",\"httpMethod\":\"$context.httpMethod\",\"resourcePath\":\"$context.resourcePath\",\"status\":\"$context.status\",\"responseLength\":\"$context.responseLength\",\"user\":\"$context.authorizer.claims.sub\"}'\n"}}}}]}, {"ruleId": "CKV_AWS_73", "ruleIndex": 1, "level": "error", "attachments": [], "message": {"text": "Ensure API Gateway has X-Ray Tracing enabled"}, "locations": [{"physicalLocation": {"artifactLocation": {"uri": "cloudformation/nested/api.yaml"}, "region": {"startLine": 372, "endLine": 383, "snippet": {"text": "  ReadApiStage:\n    Type: AWS::ApiGateway::Stage\n    DependsOn: ApiGatewayAccount\n    Properties:\n      RestApiId: !Ref ReadApi\n      StageName: v1\n      DeploymentId: !Ref ReadApiDeployment9c2ad4\n      Description: The stage the client calls.\n      TracingEnabled: false\n      AccessLogSetting:\n        DestinationArn: !GetAtt ReadApiAccessLogGroup.Arn\n        Format: '{\"requestId\":\"$context.requestId\",\"extendedRequestId\":\"$context.extendedRequestId\",\"ip\":\"$context.identity.sourceIp\",\"requestTime\":\"$context.requestTime\",\"httpMethod\":\"$context.httpMethod\",\"resourcePath\":\"$context.resourcePath\",\"status\":\"$context.status\",\"responseLength\":\"$context.responseLength\",\"user\":\"$context.authorizer.claims.sub\"}'\n"}}}}]}, {"ruleId": "CKV_AWS_21", "ruleIndex": 2, "level": "error", "attachments": [], "message": {"text": "Ensure the S3 bucket has versioning enabled"}, "locations": [{"physicalLocation": {"artifactLocation": {"uri": "cloudformation/nested/storage.yaml"}, "region": {"startLine": 93, "endLine": 124, "snippet": {"text": "  AthenaResultsBucket:\n    Type: AWS::S3::Bucket\n    Properties:\n      # Bucket names are global, so the account id is what keeps this one unique.\n      BucketName: !Sub '${ProjectSlug}-${Environment}-athena-results-${AWS::AccountId}'\n      BucketEncryption:\n        ServerSideEncryptionConfiguration:\n          - ServerSideEncryptionByDefault:\n              SSEAlgorithm: aws:kms\n              KMSMasterKeyID: !Ref KmsKeyArn\n            BucketKeyEnabled: true\n      PublicAccessBlockConfiguration:\n        BlockPublicAcls: true\n        BlockPublicPolicy: true\n        IgnorePublicAcls: true\n        RestrictPublicBuckets: true\n      OwnershipControls:\n        Rules:\n          - ObjectOwnership: BucketOwnerEnforced\n      # Query results are transient output that the lifecycle rule expires, so no\n      # versions are kept.\n      VersioningConfiguration:\n        Status: Suspended\n      LifecycleConfiguration:\n        Rules:\n          - Id: expire-query-results\n            Status: Enabled\n            ExpirationInDays: 7\n          - Id: abort-incomplete-uploads\n            Status: Enabled\n            AbortIncompleteMultipartUpload:\n              DaysAfterInitiation: 7\n"}}}}]}, {"ruleId": "CKV_AWS_18", "ruleIndex": 3, "level": "error", "attachments": [], "message": {"text": "Ensure the S3 bucket has access logging enabled"}, "locations": [{"physicalLocation": {"artifactLocation": {"uri": "cloudformation/nested/storage.yaml"}, "region": {"startLine": 93, "endLine": 124, "snippet": {"text": "  AthenaResultsBucket:\n    Type: AWS::S3::Bucket\n    Properties:\n      # Bucket names are global, so the account id is what keeps this one unique.\n      BucketName: !Sub '${ProjectSlug}-${Environment}-athena-results-${AWS::AccountId}'\n      BucketEncryption:\n        ServerSideEncryptionConfiguration:\n          - ServerSideEncryptionByDefault:\n              SSEAlgorithm: aws:kms\n              KMSMasterKeyID: !Ref KmsKeyArn\n            BucketKeyEnabled: true\n      PublicAccessBlockConfiguration:\n        BlockPublicAcls: true\n        BlockPublicPolicy: true\n        IgnorePublicAcls: true\n        RestrictPublicBuckets: true\n      OwnershipControls:\n        Rules:\n          - ObjectOwnership: BucketOwnerEnforced\n      # Query results are transient output that the lifecycle rule expires, so no\n      # versions are kept.\n      VersioningConfiguration:\n        Status: Suspended\n      LifecycleConfiguration:\n        Rules:\n          - Id: expire-query-results\n            Status: Enabled\n            ExpirationInDays: 7\n          - Id: abort-incomplete-uploads\n            Status: Enabled\n            AbortIncompleteMultipartUpload:\n              DaysAfterInitiation: 7\n"}}}}]}, {"ruleId": "CKV_AWS_18", "ruleIndex": 3, "level": "error", "attachments": [], "message": {"text": "Ensure the S3 bucket has access logging enabled"}, "locations": [{"physicalLocation": {"artifactLocation": {"uri": "cloudformation/nested/engine.yaml"}, "region": {"startLine": 181, "endLine": 235, "snippet": {"text": "  RawLandingBucket:\n    Type: AWS::S3::Bucket\n    # S3 validates the invoke permission when the notification is configured, so\n    # the permission has to exist first.\n    DependsOn: RawBucketInvokePermission\n    Properties:\n      BucketName: !Sub '${ProjectSlug}-${Environment}-raw-${AWS::AccountId}'\n      BucketEncryption:\n        ServerSideEncryptionConfiguration:\n          - BucketKeyEnabled: true\n            ServerSideEncryptionByDefault:\n              SSEAlgorithm: aws:kms\n              KMSMasterKeyID: !Ref KmsKeyArn\n      PublicAccessBlockConfiguration:\n        BlockPublicAcls: true\n        BlockPublicPolicy: true\n        IgnorePublicAcls: true\n        RestrictPublicBuckets: true\n      OwnershipControls:\n        Rules:\n          - ObjectOwnership: BucketOwnerEnforced\n      # The function keys its delivery claim on bucket, key and object version,\n      # so a bucket without versioning cannot tell a redelivery from a redrop.\n      VersioningConfiguration:\n        Status: Enabled\n      LifecycleConfiguration:\n        Rules:\n          - Id: expire-dropped-files\n            Status: Enabled\n            Prefix: raw/\n            ExpirationInDays: !Ref RawRetentionDays\n            NoncurrentVersionExpiration:\n              NoncurrentDays: !Ref RawRetentionDays\n          - Id: expire-rejected-files\n            Status: Enabled\n            Prefix: error/\n            ExpirationInDays: !Ref RawRetentionDays\n            NoncurrentVersionExpiration:\n              NoncurrentDays: !Ref RawRetentionDays\n          - Id: abort-incomplete-uploads\n            Status: Enabled\n            AbortIncompleteMultipartUpload:\n              DaysAfterInitiation: 7\n      NotificationConfiguration:\n        LambdaConfigurations:\n          # The function writes rejected files and records to error/ in this same\n          # bucket. Without the prefix filter each of those writes invokes it\n          # again.\n          - Event: 's3:ObjectCreated:*'\n            Filter:\n              S3Key:\n                Rules:\n                  - Name: prefix\n                    Value: raw/\n            Function: !GetAtt TransformFunction.Arn\n"}}}}]}, {"ruleId": "CKV_AWS_117", "ruleIndex": 4, "level": "error", "attachments": [], "message": {"text": "Ensure that AWS Lambda function is configured inside a VPC"}, "locations": [{"physicalLocation": {"artifactLocation": {"uri": "cloudformation/nested/engine.yaml"}, "region": {"startLine": 419, "endLine": 465, "snippet": {"text": "  TransformFunction:\n    Type: AWS::Serverless::Function\n    Properties:\n      # Fixed so it matches the name of the pre-created log group above.\n      FunctionName: !Sub '${ProjectSlug}-${Environment}-transform'\n      Description: Maps a dropped file into the curated tables, updates the current-state snapshot and raises threshold events.\n      CodeUri: ../lambda/fn-transform/app/\n      Handler: handler.lambda_handler\n      Runtime: python3.14\n      Architectures:\n        - x86_64\n      # A 200000-row file is held as raw records, mapped records and one Arrow\n      # table at the same time, and the timeout was sized at this memory setting.\n      MemorySize: 1024\n      Timeout: 300\n      Role: !GetAtt TransformFunctionRole.Arn\n      KmsKeyArn: !Ref KmsKeyArn\n      LoggingConfig:\n        LogFormat: JSON\n        LogGroup: !Ref TransformLogGroup\n        ApplicationLogLevel: !Ref LogLevel\n      # S3 invokes asynchronously, so there is no caller to return an error to.\n      # A file that fails every retry lands on the queue and raises the depth\n      # alarm; without the destination the drop is lost with no signal.\n      EventInvokeConfig:\n        MaximumRetryAttempts: 2\n        MaximumEventAgeInSeconds: 3600\n        DestinationConfig:\n          OnFailure:\n            Type: SQS\n            Destination: !GetAtt TransformDeadLetterQueue.Arn\n      Environment:\n        Variables:\n          CONFIG_TABLE_NAME: !Ref ConfigTable\n          STATE_TABLE_NAME: !Ref StateTable\n          ALERT_EVENT_BUS_NAME: !Ref AlertBus\n          ALERT_EVENT_SOURCE: !Ref AlertEventSource\n          ICEBERG_CATALOG_URI: !Sub 'https://glue.${AWS::Region}.amazonaws.com/iceberg'\n          ICEBERG_WAREHOUSE: !Sub '${AWS::AccountId}:s3tablescatalog/${CuratedTableBucketName}'\n          # Paired with the raw/ notification filter above: rejected output has to\n          # land outside the prefix that triggers the function.\n          ERROR_PREFIX: 'error/'\n          METRICS_NAMESPACE: !Sub '${ProjectSlug}/${Environment}'\n          CLAIM_TTL_DAYS: !Sub '${ClaimTtlDays}'\n          POWERTOOLS_SERVICE_NAME: transform\n          POWERTOOLS_METRICS_NAMESPACE: !Sub '${ProjectSlug}/${Environment}'\n          POWERTOOLS_LOG_LEVEL: !Ref LogLevel\n"}}}}]}, {"ruleId": "CKV_AWS_116", "ruleIndex": 5, "level": "error", "attachments": [], "message": {"text": "Ensure that AWS Lambda function is configured for a Dead Letter Queue(DLQ)"}, "locations": [{"physicalLocation": {"artifactLocation": {"uri": "cloudformation/nested/engine.yaml"}, "region": {"startLine": 419, "endLine": 465, "snippet": {"text": "  TransformFunction:\n    Type: AWS::Serverless::Function\n    Properties:\n      # Fixed so it matches the name of the pre-created log group above.\n      FunctionName: !Sub '${ProjectSlug}-${Environment}-transform'\n      Description: Maps a dropped file into the curated tables, updates the current-state snapshot and raises threshold events.\n      CodeUri: ../lambda/fn-transform/app/\n      Handler: handler.lambda_handler\n      Runtime: python3.14\n      Architectures:\n        - x86_64\n      # A 200000-row file is held as raw records, mapped records and one Arrow\n      # table at the same time, and the timeout was sized at this memory setting.\n      MemorySize: 1024\n      Timeout: 300\n      Role: !GetAtt TransformFunctionRole.Arn\n      KmsKeyArn: !Ref KmsKeyArn\n      LoggingConfig:\n        LogFormat: JSON\n        LogGroup: !Ref TransformLogGroup\n        ApplicationLogLevel: !Ref LogLevel\n      # S3 invokes asynchronously, so there is no caller to return an error to.\n      # A file that fails every retry lands on the queue and raises the depth\n      # alarm; without the destination the drop is lost with no signal.\n      EventInvokeConfig:\n        MaximumRetryAttempts: 2\n        MaximumEventAgeInSeconds: 3600\n        DestinationConfig:\n          OnFailure:\n            Type: SQS\n            Destination: !GetAtt TransformDeadLetterQueue.Arn\n      Environment:\n        Variables:\n          CONFIG_TABLE_NAME: !Ref ConfigTable\n          STATE_TABLE_NAME: !Ref StateTable\n          ALERT_EVENT_BUS_NAME: !Ref AlertBus\n          ALERT_EVENT_SOURCE: !Ref AlertEventSource\n          ICEBERG_CATALOG_URI: !Sub 'https://glue.${AWS::Region}.amazonaws.com/iceberg'\n          ICEBERG_WAREHOUSE: !Sub '${AWS::AccountId}:s3tablescatalog/${CuratedTableBucketName}'\n          # Paired with the raw/ notification filter above: rejected output has to\n          # land outside the prefix that triggers the function.\n          ERROR_PREFIX: 'error/'\n          METRICS_NAMESPACE: !Sub '${ProjectSlug}/${Environment}'\n          CLAIM_TTL_DAYS: !Sub '${ClaimTtlDays}'\n          POWERTOOLS_SERVICE_NAME: transform\n          POWERTOOLS_METRICS_NAMESPACE: !Sub '${ProjectSlug}/${Environment}'\n          POWERTOOLS_LOG_LEVEL: !Ref LogLevel\n"}}}}]}, {"ruleId": "CKV_AWS_115", "ruleIndex": 6, "level": "error", "attachments": [], "message": {"text": "Ensure that AWS Lambda function is configured for function-level concurrent execution limit"}, "locations": [{"physicalLocation": {"artifactLocation": {"uri": "cloudformation/nested/engine.yaml"}, "region": {"startLine": 419, "endLine": 465, "snippet": {"text": "  TransformFunction:\n    Type: AWS::Serverless::Function\n    Properties:\n      # Fixed so it matches the name of the pre-created log group above.\n      FunctionName: !Sub '${ProjectSlug}-${Environment}-transform'\n      Description: Maps a dropped file into the curated tables, updates the current-state snapshot and raises threshold events.\n      CodeUri: ../lambda/fn-transform/app/\n      Handler: handler.lambda_handler\n      Runtime: python3.14\n      Architectures:\n        - x86_64\n      # A 200000-row file is held as raw records, mapped records and one Arrow\n      # table at the same time, and the timeout was sized at this memory setting.\n      MemorySize: 1024\n      Timeout: 300\n      Role: !GetAtt TransformFunctionRole.Arn\n      KmsKeyArn: !Ref KmsKeyArn\n      LoggingConfig:\n        LogFormat: JSON\n        LogGroup: !Ref TransformLogGroup\n        ApplicationLogLevel: !Ref LogLevel\n      # S3 invokes asynchronously, so there is no caller to return an error to.\n      # A file that fails every retry lands on the queue and raises the depth\n      # alarm; without the destination the drop is lost with no signal.\n      EventInvokeConfig:\n        MaximumRetryAttempts: 2\n        MaximumEventAgeInSeconds: 3600\n        DestinationConfig:\n          OnFailure:\n            Type: SQS\n            Destination: !GetAtt TransformDeadLetterQueue.Arn\n      Environment:\n        Variables:\n          CONFIG_TABLE_NAME: !Ref ConfigTable\n          STATE_TABLE_NAME: !Ref StateTable\n          ALERT_EVENT_BUS_NAME: !Ref AlertBus\n          ALERT_EVENT_SOURCE: !Ref AlertEventSource\n          ICEBERG_CATALOG_URI: !Sub 'https://glue.${AWS::Region}.amazonaws.com/iceberg'\n          ICEBERG_WAREHOUSE: !Sub '${AWS::AccountId}:s3tablescatalog/${CuratedTableBucketName}'\n          # Paired with the raw/ notification filter above: rejected output has to\n          # land outside the prefix that triggers the function.\n          ERROR_PREFIX: 'error/'\n          METRICS_NAMESPACE: !Sub '${ProjectSlug}/${Environment}'\n          CLAIM_TTL_DAYS: !Sub '${ClaimTtlDays}'\n          POWERTOOLS_SERVICE_NAME: transform\n          POWERTOOLS_METRICS_NAMESPACE: !Sub '${ProjectSlug}/${Environment}'\n          POWERTOOLS_LOG_LEVEL: !Ref LogLevel\n"}}}}]}]}]}